#!/bin/bash
# .claude/_personal/scripts/git/parallel.sh
# Comando interactivo de Claude Code para crear entornos de desarrollo paralelos
# Uso: /parallel <nombre-branch> [opciones]

set -e

# Colores para output mejorado
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Función para logging con formato
log_info() {
    echo -e "${BLUE}ℹ️  ${NC}$1"
}

log_success() {
    echo -e "${GREEN}✅ ${NC}$1"
}

log_warning() {
    echo -e "${YELLOW}⚠️  ${NC}$1"
}

log_error() {
    echo -e "${RED}❌ ${NC}$1"
}

log_step() {
    echo -e "\n${CYAN}═══════════════════════════════════════════════${NC}"
    echo -e "${CYAN}▶ ${BOLD}$1${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════${NC}"
}

# Función para mostrar ayuda
show_help() {
    cat << EOF
${BOLD}📦 PARALLEL DEVELOPMENT ENVIRONMENT${NC}

${CYAN}Uso:${NC}
  /parallel <nombre-branch> [opciones]

${CYAN}Descripción:${NC}
  Crea un entorno de desarrollo paralelo con puertos únicos,
  permitiendo trabajar en múltiples features simultáneamente.

${CYAN}Argumentos:${NC}
  nombre-branch    Nombre de la nueva rama (ej: feature/nueva-api)

${CYAN}Opciones:${NC}
  --dry-run        Simula la ejecución sin hacer cambios
  --no-cache       No compartir cache con proyecto principal
  --port-offset    Offset manual para puertos (default: auto)
  --skip-git       No crear rama Git
  --help           Muestra esta ayuda

${CYAN}Ejemplos:${NC}
  /parallel feature/nueva-api
  /parallel hotfix/bug-critico --dry-run
  /parallel experiment/test --port-offset 100

${CYAN}Comandos relacionados:${NC}
  /parallel-status    Ver todos los entornos paralelos activos
  /parallel-cleanup   Limpiar entornos paralelos inactivos
  /parallel-switch    Cambiar entre entornos paralelos

${CYAN}Notas:${NC}
  • Los puertos se asignan automáticamente evitando conflictos
  • El cache de Claude se comparte por defecto entre entornos
  • Cada entorno tiene su propia configuración local (.env.local)
  • Los cambios locales NO se commitean (están en .gitignore)

EOF
}

# Parsear argumentos
BRANCH_NAME=""
DRY_RUN=false
NO_CACHE=false
PORT_OFFSET=""
SKIP_GIT=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --help|-h)
            show_help
            exit 0
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --no-cache)
            NO_CACHE=true
            shift
            ;;
        --port-offset)
            PORT_OFFSET="$2"
            shift 2
            ;;
        --skip-git)
            SKIP_GIT=true
            shift
            ;;
        *)
            if [ -z "$BRANCH_NAME" ]; then
                BRANCH_NAME="$1"
            fi
            shift
            ;;
    esac
done

# Validar argumentos
if [ -z "$BRANCH_NAME" ]; then
    log_error "Nombre de branch requerido"
    echo ""
    echo "Uso: /parallel <nombre-branch>"
    echo "Para más información: /parallel --help"
    exit 1
fi

# Calcular directorios y variables
BASE_DIR="$(pwd)"
PROJECT_NAME="$(basename $BASE_DIR)"
WORKTREE_DIR="../${PROJECT_NAME}-${BRANCH_NAME//\//-}"
PARALLEL_INFO_FILE="$BASE_DIR/.claude/_personal/parallel-envs.json"

# Función mejorada para detectar servicios y puertos
detect_services_and_ports() {
    log_step "ANÁLISIS INTELIGENTE DEL PROYECTO"
    
    echo -e "${CYAN}🔍 Detectando servicios...${NC}"
    
    # Detectar tipo de proyecto
    local project_type=""
    local services=()
    
    if [ -f "docker-compose.yml" ] || [ -f "docker-compose.yaml" ]; then
        project_type="docker-compose"
        log_info "Proyecto Docker Compose detectado"
        
        # Extraer servicios de docker-compose
        if command -v yq &> /dev/null; then
            services=($(yq eval '.services | keys | .[]' docker-compose.yml 2>/dev/null || true))
        else
            services=($(grep -E "^[[:space:]]*[a-zA-Z0-9_-]+:" docker-compose.yml | sed 's/://g' | tr -d ' ' || true))
        fi
        
        if [ ${#services[@]} -gt 0 ]; then
            echo -e "${GREEN}  Servicios Docker:${NC}"
            for service in "${services[@]}"; do
                echo -e "    • $service"
            done
        fi
    fi
    
    if [ -f "package.json" ]; then
        [ -z "$project_type" ] && project_type="node" || project_type="$project_type+node"
        log_info "Proyecto Node.js detectado"
        
        # Detectar framework
        local framework=""
        if grep -q '"next"' package.json 2>/dev/null; then
            framework="Next.js"
        elif grep -q '"react"' package.json 2>/dev/null; then
            framework="React"
        elif grep -q '"vue"' package.json 2>/dev/null; then
            framework="Vue"
        elif grep -q '"@angular"' package.json 2>/dev/null; then
            framework="Angular"
        fi
        
        [ -n "$framework" ] && echo -e "${GREEN}  Framework: $framework${NC}"
    fi
    
    if [ -f "requirements.txt" ] || [ -f "pyproject.toml" ] || [ -f "Pipfile" ]; then
        [ -z "$project_type" ] && project_type="python" || project_type="$project_type+python"
        log_info "Proyecto Python detectado"
        
        # Detectar framework Python
        if [ -f "manage.py" ]; then
            echo -e "${GREEN}  Framework: Django${NC}"
        elif grep -q "fastapi\|FastAPI" requirements.txt pyproject.toml Pipfile 2>/dev/null; then
            echo -e "${GREEN}  Framework: FastAPI${NC}"
        elif grep -q "flask\|Flask" requirements.txt pyproject.toml Pipfile 2>/dev/null; then
            echo -e "${GREEN}  Framework: Flask${NC}"
        fi
    fi
    
    if [ -f "Makefile" ]; then
        log_info "Makefile detectado - comandos disponibles:"
        # Mostrar targets principales del Makefile
        local targets=$(grep -E "^[a-zA-Z0-9_-]+:" Makefile | head -5 | cut -d: -f1 | tr '\n' ' ')
        echo -e "${GREEN}  Targets: $targets${NC}"
    fi
    
    echo ""
    echo -e "${CYAN}🔍 Detectando puertos en uso...${NC}"
    
    # Detección mejorada de puertos
    local port_sources=()
    
    # Buscar en múltiples tipos de archivos
    local file_patterns=(
        "*.yml" "*.yaml" "*.json" "*.env*" "*.md" 
        "*.py" "*.js" "*.ts" "*.toml" "*.conf" "*.config"
        "Dockerfile*" "docker-compose*" "Makefile"
    )
    
    PORTS_FOUND=""
    for pattern in "${file_patterns[@]}"; do
        local found_ports=$(find . -maxdepth 3 -name "$pattern" -type f 2>/dev/null | \
            xargs grep -h -o -E "(localhost:|127\.0\.0\.1:|0\.0\.0\.0:|port[[:space:]]*[:=][[:space:]]*|PORT[[:space:]]*[:=][[:space:]]*)[0-9]{4,5}" 2>/dev/null | \
            grep -o -E "[0-9]{4,5}" | sort -u)
        
        if [ -n "$found_ports" ]; then
            PORTS_FOUND="$PORTS_FOUND $found_ports"
        fi
    done
    
    # Eliminar duplicados y ordenar
    PORTS_FOUND=$(echo $PORTS_FOUND | tr ' ' '\n' | sort -u | grep -E "^[0-9]{4,5}$")
    
    # Mostrar puertos encontrados con contexto
    if [ -n "$PORTS_FOUND" ]; then
        echo -e "${GREEN}  Puertos detectados:${NC}"
        for port in $PORTS_FOUND; do
            # Intentar identificar el servicio del puerto
            local service_hint=""
            if grep -q "$port" docker-compose.yml docker-compose.yaml 2>/dev/null; then
                service_hint="(Docker)"
            elif grep -q "$port" .env .env.example 2>/dev/null; then
                service_hint="(Environment)"
            elif grep -q "$port" package.json 2>/dev/null; then
                service_hint="(Node.js)"
            fi
            
            echo -e "    • ${BOLD}$port${NC} $service_hint"
        done
    else
        log_warning "No se detectaron puertos específicos"
    fi
    
    # No retornamos nada, solo mostramos información
}

# Función para verificar conflictos
check_conflicts() {
    log_step "VERIFICACIÓN DE CONFLICTOS"
    
    local has_conflicts=false
    
    # Verificar si el directorio destino existe
    if [ -d "$WORKTREE_DIR" ]; then
        log_warning "El directorio $WORKTREE_DIR ya existe"
        echo -e "${YELLOW}Opciones:${NC}"
        echo "  1. Eliminar y recrear (se perderán cambios no guardados)"
        echo "  2. Usar un nombre diferente"
        echo "  3. Cancelar"
        
        if [ "$DRY_RUN" = false ]; then
            read -p "Seleccione una opción [1-3]: " choice
            case $choice in
                1)
                    log_info "Eliminando directorio existente..."
                    rm -rf "$WORKTREE_DIR"
                    ;;
                2)
                    read -p "Nuevo nombre de branch: " new_branch
                    BRANCH_NAME="$new_branch"
                    WORKTREE_DIR="../${PROJECT_NAME}-${BRANCH_NAME//\//-}"
                    check_conflicts  # Recursivo
                    return
                    ;;
                3)
                    log_info "Operación cancelada"
                    exit 0
                    ;;
                *)
                    log_error "Opción inválida"
                    exit 1
                    ;;
            esac
        else
            has_conflicts=true
        fi
    fi
    
    # Verificar si la rama Git ya existe
    if [ "$SKIP_GIT" = false ] && git rev-parse --verify "$BRANCH_NAME" &>/dev/null; then
        log_warning "La rama Git '$BRANCH_NAME' ya existe"
        if [ "$DRY_RUN" = false ]; then
            read -p "¿Usar la rama existente? [y/N]: " use_existing
            if [[ ! "$use_existing" =~ ^[Yy]$ ]]; then
                log_info "Operación cancelada"
                exit 0
            fi
        else
            has_conflicts=true
        fi
    fi
    
    # Verificar puertos en uso
    if [ -n "$PORTS_FOUND" ]; then
        log_info "Verificando disponibilidad de puertos..."
        for port in $PORTS_FOUND; do
            local offset=${PORT_OFFSET:-$(($(echo "$BRANCH_NAME" | cksum | cut -d' ' -f1) % 100))}
            local new_port=$((port + offset))
            if timeout 3s netstat -tuln 2>/dev/null | grep -q ":$new_port "; then
                log_warning "Puerto $new_port ya está en uso"
                has_conflicts=true
            fi
        done
    fi
    
    if [ "$has_conflicts" = true ] && [ "$DRY_RUN" = true ]; then
        log_warning "Se detectaron conflictos potenciales (modo dry-run)"
    else
        log_success "No se detectaron conflictos"
    fi
}

# Función auxiliar para detectar solo puertos (sin output de display)
detect_ports_only() {
    # Detección de puertos sin output visual
    local file_patterns=(
        "*.yml" "*.yaml" "*.json" "*.env*" "*.md" 
        "*.py" "*.js" "*.ts" "*.toml" "*.conf" "*.config"
        "Dockerfile*" "docker-compose*" "Makefile"
    )
    
    local ports_found=""
    for pattern in "${file_patterns[@]}"; do
        local found_ports=$(find . -maxdepth 3 -name "$pattern" -type f 2>/dev/null | \
            xargs grep -h -o -E "(localhost:|127\.0\.0\.1:|0\.0\.0\.0:|port[[:space:]]*[:=][[:space:]]*|PORT[[:space:]]*[:=][[:space:]]*)[0-9]{4,5}" 2>/dev/null | \
            grep -o -E "[0-9]{4,5}" | sort -u)
        
        if [ -n "$found_ports" ]; then
            ports_found="$ports_found $found_ports"
        fi
    done
    
    # Eliminar duplicados y ordenar, solo retornar puertos
    echo $(echo $ports_found | tr ' ' '\n' | sort -u | grep -E "^[0-9]{4,5}$")
}

# Función principal mejorada
main() {
    log_step "CONFIGURACIÓN DE ENTORNO PARALELO"
    
    echo -e "${BOLD}Proyecto:${NC} $PROJECT_NAME"
    echo -e "${BOLD}Branch:${NC} $BRANCH_NAME"
    echo -e "${BOLD}Directorio destino:${NC} $WORKTREE_DIR"
    
    if [ "$DRY_RUN" = true ]; then
        echo -e "${YELLOW}${BOLD}MODO DRY-RUN ACTIVADO${NC}"
    fi
    
    # Detectar servicios y puertos
    detect_services_and_ports
    # Ejecutar solo la detección de puertos para capturar resultado
    PORTS_FOUND=$(detect_ports_only)
    
    # Verificar conflictos
    check_conflicts
    
    # Calcular mapeo de puertos
    if [ -z "$PORT_OFFSET" ]; then
        PORT_OFFSET=$(($(echo "$BRANCH_NAME" | cksum | cut -d' ' -f1) % 100))
    fi
    
    log_step "MAPEO DE PUERTOS"
    
    declare -A PORT_MAPPING
    if [ -n "$PORTS_FOUND" ]; then
        echo -e "${CYAN}Offset calculado: +$PORT_OFFSET${NC}"
        echo -e "\n${BOLD}Mapeo de puertos:${NC}"
        
        for port in $PORTS_FOUND; do
            if [ "$port" -ge 3000 ] && [ "$port" -le 9999 ]; then
                new_port=$((port + PORT_OFFSET))
                
                # Evitar puertos reservados y en uso
                while [ $new_port -gt 9999 ] || timeout 3s netstat -tuln 2>/dev/null | grep -q ":$new_port "; do
                    new_port=$((new_port + 1))
                done
                
                PORT_MAPPING[$port]=$new_port
                echo -e "  ${BOLD}$port${NC} → ${GREEN}$new_port${NC}"
            fi
        done
    else
        log_info "No se requiere mapeo de puertos"
    fi
    
    # Preview de URLs actualizadas (con timeout y fallback)
    if [ ${#PORT_MAPPING[@]} -gt 0 ]; then
        log_step "PREVIEW DE ACCESS POINTS"
        
        # URLs hardcodeadas para evitar dependencia de README.md
        echo -e "  ${GREEN}- **API Backend**: http://localhost:$([ -n "${PORT_MAPPING[8000]}" ] && echo "${PORT_MAPPING[8000]}" || echo "8075")${NC}"
        echo -e "  ${GREEN}- **Documentación API**: http://localhost:$([ -n "${PORT_MAPPING[8000]}" ] && echo "${PORT_MAPPING[8000]}" || echo "8075")/docs${NC}"
        echo -e "  ${GREEN}- **Health Check**: http://localhost:$([ -n "${PORT_MAPPING[8000]}" ] && echo "${PORT_MAPPING[8000]}" || echo "8075")/api/health${NC}"
        echo -e "  ${GREEN}- **Admin Dashboard (HTMX)**: http://localhost:$([ -n "${PORT_MAPPING[8501]}" ] && echo "${PORT_MAPPING[8501]}" || echo "8576")${NC}"
        echo -e "  ${GREEN}- **Adminer (DB)**: http://localhost:$([ -n "${PORT_MAPPING[8080]}" ] && echo "${PORT_MAPPING[8080]}" || echo "8155")${NC}"
    fi
    
    # Confirmación interactiva (con timeout y auto-aceptar en no interactivo)
    if [ "$DRY_RUN" = false ]; then
        echo ""
        if [ -t 0 ] && [ -t 1 ]; then  # Solo si es terminal interactiva
            read -t 10 -p "$(echo -e ${CYAN}¿Proceder con la configuración? [Y/n]: ${NC})" confirm 2>/dev/null || confirm="y"
        else
            confirm="y"  # Auto-aceptar en entornos no interactivos (Claude Code)
            log_info "Modo no interactivo: procediendo automáticamente"
        fi
        
        if [[ "$confirm" =~ ^[Nn]$ ]]; then
            log_info "Operación cancelada"
            exit 0
        fi
    fi
    
    # Si es dry-run, terminar aquí
    if [ "$DRY_RUN" = true ]; then
        log_step "RESUMEN (DRY-RUN)"
        echo -e "${GREEN}La configuración se ejecutaría correctamente${NC}"
        echo -e "\n${CYAN}Acciones que se realizarían:${NC}"
        echo "  1. Copiar proyecto a $WORKTREE_DIR"
        echo "  2. Mapear ${#PORT_MAPPING[@]} puertos"
        [ "$SKIP_GIT" = false ] && echo "  3. Crear rama Git: $BRANCH_NAME"
        [ "$NO_CACHE" = false ] && echo "  4. Compartir cache con proyecto principal"
        echo "  5. Crear scripts de inicio personalizados"
        exit 0
    fi
    
    # EJECUTAR CONFIGURACIÓN
    log_step "EJECUTANDO CONFIGURACIÓN"
    
    # 1. Copiar proyecto
    log_info "Copiando proyecto..."
    cp -r "$BASE_DIR" "$WORKTREE_DIR"
    log_success "Proyecto copiado"
    
    cd "$WORKTREE_DIR"
    
    # 2. Aplicar mapeo de puertos
    if [ ${#PORT_MAPPING[@]} -gt 0 ]; then
        log_info "Aplicando configuración de puertos..."
        
        # Crear archivos de configuración local
        for file in .env docker-compose.yml package.json; do
            if [ -f "$file" ]; then
                local local_file="${file}.local"
                cp "$file" "$local_file"
                
                for original_port in "${!PORT_MAPPING[@]}"; do
                    new_port=${PORT_MAPPING[$original_port]}
                    sed -i "s/:$original_port/:$new_port/g" "$local_file"
                    sed -i "s/=$original_port/=$new_port/g" "$local_file"
                    sed -i "s/\"$original_port\"/\"$new_port\"/g" "$local_file"
                done
                
                log_success "Creado: $local_file"
            fi
        done
    fi
    
    # 3. Configurar Git
    if [ "$SKIP_GIT" = false ]; then
        log_info "Configurando Git..."
        git checkout -b "$BRANCH_NAME" 2>/dev/null || git checkout "$BRANCH_NAME"
        log_success "Rama Git configurada: $BRANCH_NAME"
    fi
    
    # 4. Configurar knowledge-base compartido
    if [ "$NO_CACHE" = false ]; then
        log_info "Configurando knowledge-base compartido..."
        
        # Crear estructura de directorios si no existe
        mkdir -p .claude/_personal/data/debug
        
        # Solo compartir el knowledge-base.json
        if [ -f "$BASE_DIR/.claude/_personal/data/debug/knowledge-base.json" ]; then
            ln -sf "$BASE_DIR/.claude/_personal/data/debug/knowledge-base.json" \
                   ".claude/_personal/data/debug/knowledge-base.json"
            log_success "Knowledge-base compartido configurado"
        else
            log_warning "No se encontró knowledge-base.json en proyecto principal"
            log_info "Se creará uno nuevo cuando sea necesario"
        fi
    fi
    
    # 5. Crear script de inicio
    log_info "Creando script de inicio..."
    create_start_script
    log_success "Script de inicio creado: start-local.sh"
    
    # 6. Registrar entorno paralelo
    register_parallel_env
    
    # RESUMEN FINAL
    log_step "✨ ENTORNO PARALELO LISTO"
    
    echo -e "${GREEN}${BOLD}Configuración completada exitosamente${NC}\n"
    
    echo -e "${CYAN}📁 Ubicación:${NC} $WORKTREE_DIR"
    echo -e "${CYAN}🌿 Rama:${NC} $BRANCH_NAME"
    echo -e "${CYAN}🌐 Puertos:${NC} ${#PORT_MAPPING[@]} mapeados"
    [ "$NO_CACHE" = false ] && echo -e "${CYAN}💾 Knowledge-base:${NC} Compartido"
    
    echo -e "\n${CYAN}${BOLD}Próximos pasos:${NC}"
    echo -e "  1. ${YELLOW}cd $WORKTREE_DIR${NC}"
    echo -e "  2. ${YELLOW}./start-local.sh${NC} - Iniciar servicios"
    echo -e "  3. ${YELLOW}claude code${NC} - Abrir en Claude Code"
    
    echo -e "\n${CYAN}${BOLD}Comandos útiles:${NC}"
    echo -e "  ${YELLOW}/parallel-status${NC}  - Ver todos los entornos"
    echo -e "  ${YELLOW}/parallel-switch${NC}  - Cambiar entre entornos"
    echo -e "  ${YELLOW}/parallel-cleanup${NC} - Limpiar entornos inactivos"
}

# Función para crear script de inicio personalizado
create_start_script() {
    cat > start-local.sh << 'SCRIPT_EOF'
#!/bin/bash
# Script de inicio para entorno paralelo

echo "🚀 INICIANDO ENTORNO PARALELO"
echo "=============================="

# Cargar configuración local
for config in .env.local docker-compose.yml.local package.json.local; do
    if [ -f "$config" ]; then
        echo "📝 Usando configuración: $config"
    fi
done

# Detectar y ejecutar comando de inicio
if [ -f "Makefile" ] && grep -q "^dev:" Makefile; then
    echo "🔧 Ejecutando: make dev"
    make dev
elif [ -f "docker-compose.yml.local" ]; then
    echo "🐳 Ejecutando: docker-compose -f docker-compose.yml.local up"
    docker-compose -f docker-compose.yml.local up
elif [ -f "package.json.local" ]; then
    echo "📦 Ejecutando: npm start (con configuración local)"
    mv package.json package.json.backup
    mv package.json.local package.json
    npm start
    mv package.json package.json.local
    mv package.json.backup package.json
else
    echo "❌ No se encontró método de inicio automático"
    echo "💡 Configura manualmente o revisa la documentación"
fi
SCRIPT_EOF
    
    chmod +x start-local.sh
}

# Función para registrar entorno paralelo
register_parallel_env() {
    local env_info=$(cat << EOF
{
  "branch": "$BRANCH_NAME",
  "path": "$WORKTREE_DIR",
  "created": "$(date -Iseconds)",
  "port_offset": $PORT_OFFSET,
  "ports_mapped": ${#PORT_MAPPING[@]},
  "cache_shared": $([ "$NO_CACHE" = false ] && echo "true" || echo "false")
}
EOF
)
    
    # Crear archivo de registro si no existe
    if [ ! -f "$PARALLEL_INFO_FILE" ]; then
        echo "[]" > "$PARALLEL_INFO_FILE"
    fi
    
    # Agregar nuevo entorno al registro (requiere jq)
    if command -v jq &> /dev/null; then
        local updated=$(jq ". += [$env_info]" "$PARALLEL_INFO_FILE")
        echo "$updated" > "$PARALLEL_INFO_FILE"
    fi
}

# Ejecutar función principal
main "$@"