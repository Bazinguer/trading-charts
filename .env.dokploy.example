# Variables del proyecto en Dokploy (pestaña Environment). Copia estos
# nombres y rellena los valores REALES solo allí — nunca en el repo.
GITHUB_REPO=bazinguer/trading-charts
TAG=latest
DOMAIN=charts.bazinguer.es

# Credenciales NUEVAS de producción (no reutilizar las de desarrollo)
CHARTS_USUARIO=usuario_prd
CHARTS_PASSWORD=password_larga_prd
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
CHARTS_SECRET=hex_aleatorio_de_64_caracteres
